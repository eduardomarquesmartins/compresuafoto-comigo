# URL pública da aplicação de fotos dentro do domínio principal.
CLIENT_URL=https://econticomigo.com.br/compresuafoto

# URL pública da Econti. Os links de assinatura de contratos usam esta URL.
ECONTI_PUBLIC_URL=https://econticomigo.com.br

# Inclua as duas origens caso a API esteja em outro host.
CORS_ORIGINS=https://econticomigo.com.br,https://www.econticomigo.com.br

# Remetente já verificado no Resend para o domínio econti.com.br.
EMAIL_FROM=Compre Sua Foto <contato@econti.com.br>
