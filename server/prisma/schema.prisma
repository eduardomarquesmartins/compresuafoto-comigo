generator client {
  provider = "prisma-client-js"
  output   = "./generated-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  password         String
  role             String    @default("CUSTOMER")
  name             String?
  fullName         String?
  cpf              String?   @unique
  phone            String?   @unique
  securityQuestion String?
  securityAnswer   String?
  googleId         String?   @unique
  collaboratorProfile CollaboratorProfile?
  profileLockedAt  DateTime?
  mustChangePassword Boolean @default(false)
  authVersion      Int      @default(1)
  contractUrl      String?
  lastLogin        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  orders           Order[]
  completedServices ServiceCompletion[] @relation("CollaboratorServices")
  serviceDefinitions ServiceDefinition[] @relation("ServiceCollaborator")
}

enum CollaboratorProfile {
  DESIGNER
  COMPANY_DEMANDS
}

model Event {
  id          Int      @id @default(autoincrement())
  name        String
  date        DateTime
  description String?
  coverImage  String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  photos      Photo[]
}

model Photo {
  id             Int      @id @default(autoincrement())
  eventId        Int
  originalUrl    String
  watermarkedUrl String?
  price          Float    @default(10.0)
  signatureToken String?  @unique
  signedAt       DateTime?
  signedName     String?
  signedDocument String?
  createdAt      DateTime @default(now())
  embedding      String?
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Order {
  id         Int      @id @default(autoincrement())
  publicId   String   @unique @default(uuid())
  total      Float
  status     String   @default("PENDING")
  items      String
  userId     Int
  couponCode String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  discountType  String
  discountValue Float
  expiryDate    DateTime?
  maxUses       Int?
  usedCount     Int           @default(0)
  isActive      Boolean       @default(true)
  freePhotos    Int           @default(0)
  oncePerCpf    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  usages        CouponUsage[]
}

model CouponUsage {
  id        Int      @id @default(autoincrement())
  couponId  Int
  cpf       String
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, cpf])
}

model Proposal {
  id               Int      @id @default(autoincrement())
  clientId         Int?
  clientName       String
  clientEmail      String?
  selectedServices String
  total            Float
  status           String   @default("PENDING")
  proposalType     String   @default("empresarial")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  client           Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model Client {
  id             Int               @id @default(autoincrement())
  name           String
  email          String            @unique
  document       String?
  phone          String?
  address        String?
  cityState      String?
  signerName     String?
  signerDocument String?
  status         String            @default("ACTIVE")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  contracts      Contract[]
  financials     FinancialRecord[]
  proposals      Proposal[]
}

model Contract {
  id             Int      @id @default(autoincrement())
  clientId       Int
  scope          String
  monthlyValue   Float
  durationMonths Int      @default(6)
  paymentDay     Int      @default(25)
  startDate      DateTime @default(now())
  endDate        DateTime?
  status         String   @default("ACTIVE")
  signatureToken String?  @unique
  signedAt       DateTime?
  signedName     String?
  signedDocument String?
  signedSignatureData String?
  contractDate   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model FinancialRecord {
  id          Int      @id @default(autoincrement())
  type        String
  description String
  amount      Float
  date        DateTime @default(now())
  category    String
  status      String   @default("PENDING")
  account     String?
  obs         String?
  clientId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model Debt {
  id             Int      @id @default(autoincrement())
  priority       String?
  creditor       String
  holder         String
  originalAmount Float
  bestOffer      Float
  type           String
  status         String
  obs            String?
  isCnpj         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MentoriaDemand {
  id          Int      @id @default(autoincrement())
  area        String
  action      String
  deadline    String?
  responsible String
  status      String
  type        String?
  obs         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceDefinition {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  value       Float
  role        String
  collaboratorId Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completions ServiceCompletion[]
  collaborator User? @relation("ServiceCollaborator", fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([collaboratorId])
}

model ServiceCompletion {
  id          Int      @id @default(autoincrement())
  serviceId   Int
  collaboratorId Int
  quantity    Int      @default(1)
  unitValue   Float
  totalValue  Float
  notes       String?
  completedAt DateTime @default(now())
  paymentStatus String @default("PENDING")
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  service     ServiceDefinition @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  collaborator User @relation("CollaboratorServices", fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([collaboratorId, paymentStatus])
  @@index([serviceId])
}
